        <dependency>
            <groupId>org.tweetyproject.arg</groupId>
            <artifactId>dung</artifactId>
            <version>${tweety.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
